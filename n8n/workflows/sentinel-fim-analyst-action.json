    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SENTINEL_ENGINE_URL }}/v1/actions/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Token",
              "value": "={{ $env.SENTINEL_ENGINE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ incident: $json.body.incident, action: $json.body.action, token: $json.body.token }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "405e6150-1956-520d-9bbb-4f1736b02fc4",
      "name": "Engine: ghi nhận quyết định",
