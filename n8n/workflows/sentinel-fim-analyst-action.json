{
  "name": "Sentinel-FIM · Quyết định của analyst (cách ly / dương tính giả)",
  "nodes": [
    {
      "parameters": {
        "content": "## Sentinel-FIM · Quyết định của analyst\nLink trong email chỉ mở **trang xác nhận** (GET) – bộ lọc thư tự bấm thử link sẽ không gây ra hành động. Hành động chỉ chạy khi analyst bấm **Xác nhận** (POST).\n\nToken HMAC có hạn dùng, dùng một lần, do engine kiểm tra.",
        "height": 200,
        "width": 760,
        "color": 7
      },
      "id": "3f352b4a-bc86-54cd-9fce-ae0cd3670ccb",
      "name": "Ghi chú",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -360
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "sentinel-action",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "812fd0a3-5d3a-52f7-a79b-bde4750b1787",
      "name": "Link trong email (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "f1eed290-d72d-59f6-837e-3fe0f58ed32f"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SENTINEL_ENGINE_URL }}/v1/actions/confirm",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "incident",
              "value": "={{ $json.query.incident }}"
            },
            {
              "name": "action",
              "value": "={{ $json.query.action }}"
            },
            {
              "name": "token",
              "value": "={{ $json.query.token }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Token",
              "value": "={{ $env.SENTINEL_ENGINE_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "72fc933b-b1bc-5c7c-be12-e95a661b0f12",
      "name": "Engine: kiểm tra link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
