    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ '<!doctype html><html lang=\"vi\"><head><meta charset=\"utf-8\"><title>Sentinel-FIM</title></head><body style=\"font-family:Segoe UI,Arial,sans-serif;max-width:640px;margin:40px auto;padding:0 16px\"><h2>Đã gửi lệnh cách ly</h2><p>Sự cố ' + $('Engine: ghi nhận quyết định').item.json.wazuh.body.alert.data.sentinel.incident_id + ': agent nhận lệnh = ' + Number($json.data?.total_affected_items ?? 0) + ', thất bại = ' + Number($json.data?.total_failed_items ?? 0) + '.</p><p>Kiểm tra kết quả trong <code>logs/active-responses.log</code> trên agent.</p></body></html>' }}",
        "options": {
          "responseCode": 200,
