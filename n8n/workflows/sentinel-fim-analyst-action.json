      "typeVersion": 4.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "d8e8f919-b5db-5992-8c99-6c2f13f26f7c",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "4e9207dc-2a3d-5a55-8638-c6192190bc7a",
              "leftValue": "={{ $json.action }}",
              "rightValue": "quarantine",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fc20a25d-cddf-521b-a178-c0415f40db38",
      "name": "Cách ly file?",
