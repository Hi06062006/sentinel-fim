        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Engine: ghi nhận quyết định').item.json.wazuh.body) }}",
        "options": {
          "timeout": 60000,
          "allowUnauthorizedCerts": true
        }
      },
      "id": "69401c8a-125b-525e-ab72-9d6233389c25",
      "name": "Wazuh API: chạy active response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
