# ============ Sentinel-FIM — sao chép thành .env rồi điền giá trị ============
# KHÔNG commit file .env (đã có trong .gitignore).

# --- Bí mật nội bộ (tạo bằng: openssl rand -hex 32) ---
# Token n8n dùng để gọi engine (header X-Sentinel-Token)
SENTINEL_API_TOKEN=
# Khoá HMAC ký link "Cách ly" / "Dương tính giả" trong email
ACTION_SECRET=

# --- Dịch vụ bên ngoài ---
# https://www.virustotal.com/gui/my-apikey (gói free: 4 request/phút, 500 request/ngày)
VT_API_KEY=
# https://platform.claude.com — để trống thì bỏ qua tầng phân tích L2
ANTHROPIC_API_KEY=

# --- Địa chỉ ---
# Hộp thư nhận cảnh báo
ALERT_EMAIL_TO=soc-team@example.com
# URL mà Wazuh manager và trình duyệt của analyst truy cập được tới n8n
N8N_PUBLIC_URL=http://192.168.56.10:5678/
# Link hành động trong email = webhook "sentinel-action" của n8n
ACTION_BASE_URL=http://192.168.56.10:5678/webhook/sentinel-action
# Wazuh server API (cổng 55000)
WAZUH_API_URL=https://192.168.56.20:55000

# --- Tinh chỉnh (có thể để mặc định) ---
OLLAMA_MODEL=qwen2.5:3b
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Ẩn tên người dùng trong đường dẫn và IP máy trước khi gửi cho Claude
CLAUDE_REDACT=true
# Mức tối thiểu để gửi email / để leo thang lên Claude: low | medium | high | critical
NOTIFY_MIN_SEVERITY=medium
ESCALATE_MIN_SEVERITY=high
VT_RATE_PER_MINUTE=4
VT_DAILY_QUOTA=500
VT_FETCH_MITRE=true
# Gộp alert trùng (cùng máy + cùng file + cùng hash) trong khoảng thời gian này
DEDUP_WINDOW_SECONDS=600
ACTION_TOKEN_TTL_HOURS=24
